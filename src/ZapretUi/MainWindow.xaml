<Window x:Class="ZapretUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret UI"
        Height="640" Width="780"
        MinHeight="480" MinWidth="640"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel LastChildFill="False">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Zapret UI"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" Text="…"/>
            </DockPanel>
            <TextBlock x:Name="PathWarningText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Warn}" Visibility="Collapsed"/>
            <TextBlock Margin="0,6,0,12" Foreground="{StaticResource Muted}" FontSize="12"
                       Text="Не VPN: выбираете стратегию, UI запускает winws. HTTPS-тест — дым, не проверка голоса Discord."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar x:Name="TestProgress" Margin="0,0,0,8" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="TestStatusText" Foreground="{StaticResource Muted}" Margin="0,0,0,10" Text=""/>
            <WrapPanel>
                <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Подключить" Click="Connect_Click"/>
                <Button x:Name="DisconnectButton" Content="Отключить" Click="Disconnect_Click"/>
                <Button x:Name="TestButton" Content="Проверить все" Click="TestAll_Click"/>
                <Button x:Name="CancelTestButton" Content="Отмена" Click="CancelTest_Click" IsEnabled="False"/>
            </WrapPanel>
            <CheckBox x:Name="AutostartCheck" Content="Автозапуск (служба zapret)" Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
        </StackPanel>

        <ListBox x:Name="StrategyList" Margin="0,0,0,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True" Margin="4,6">
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Result}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="ok">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="partial">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="fail">
                                            <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="best">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
