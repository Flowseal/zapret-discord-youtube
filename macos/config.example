# Скопируйте в macos/config и правьте под себя: cp macos/config.example macos/config
# Файл подключается как обычный shell-скрипт.

# --- движок ---------------------------------------------------------------
# macws — полноценный движок winws/nfqws с бэкендом пакетов для macOS:
#         fake, seqovl, multidisorder, фейки QUIC/STUN/Discord, UDP-игры.
#         Стратегии — те же .bat файлы. IPv4, нужен root.
# tpws  — прозрачный прокси: только TCP (split/disorder/oob/tlsrec), зато
#         есть режим SOCKS без root.
# auto  — macws, если он собран и прошёл `sudo ./macos/zapret.sh selftest`
ENGINE=auto

# --- стратегии ------------------------------------------------------------
# macws: имя .bat файла из корня репозитория (можно коротко: ALT4, EXP, SIMPLE FAKE)
STRATEGY_BAT=general.bat
# tpws: имя из macos/strategies.conf
STRATEGY=disorder

# Game Filter, как в service.bat: off | tcp | udp | all
GAME_FILTER=off
GAME_PORTS=1024-65535

# IPSet Filter, как в service.bat: none | loaded | any
#   none   — список адресов не используется (так же, как в свежей Windows-сборке)
#   loaded — полный список (для целей, где имя хоста не видно)
#   any    — под фильтр попадает любой адрес
# Осторожно: это меняет поведение ВСЕХ стратегий, потому что профили по ipset
# срабатывают уже на SYN, до того как виден SNI, и перебивают профили по хостлистам.
IPSET_FILTER=none

# --- IPv6 (движок macws) --------------------------------------------------
# auto — заворачивать v6, если есть маршрут и selftest подтвердил инъекцию v6
#        (для tpws auto означает просто "есть ipv6-маршрут")
# 1 — принудительно, 0 — не трогать IPv6 вовсе
IPV6=auto
UTUN_PEER6=fd77:77::2          # адрес на другом конце utun для v6
DNS6_PROBE=2001:4860:4860::8888 # по нему определяется наличие v6 и маршрут

# --- tpws -----------------------------------------------------------------
TCP_PORTS="80,443,2053,2083,2087,2096,8443"   # какие порты заворачивать
TPWS_PORT=988          # прозрачный режим
SOCKS_PORT=1080        # режим socks
TEST_PORT=10800        # режим test
BLOCK_QUIC=1           # tpws не умеет udp: глушим http/3, чтобы браузер ушёл на tcp
USE_IPSET=auto         # применять ли lists/ipset-all.txt
USE_LISTS=1            # 0 — применять стратегию ко всему трафику

# Что делать, если активный ruleset pf загружен не нами (так делают клиенты VPN:
# они грузят свой набор через pfctl -f, и ссылка на наш anchor из /etc/pf.conf
# в активном наборе исчезает, а значит заворот не работает).
#   auto — дописать ссылку в активный ruleset, сохранив правила остальных
#   0    — ничего не трогать, только предупредить
#   1    — то же, что auto
# Вернуть как было всегда можно: sudo pfctl -f /etc/pf.conf
PF_TAKEOVER=auto

# Сторож: сторонний клиент может перезагрузить свой ruleset в любой момент и снова
# затереть ссылку на наш anchor — тогда обход молча выключится. Сторож это
# отслеживает и восстанавливает. 0 — выключить.
# Сторож также снимает правила заворота, пока поднят VPN-туннель (иначе мы бы
# ломали туннельный трафик), и возвращает их, когда туннель уходит.
PF_WATCH=1
PF_WATCH_INTERVAL=10

# QUIC/HTTP3 (udp 443) для движка macws:
#   block — udp/443 глушится, браузер сразу уходит на TCP, который обходится.
#           По умолчанию, потому что QUIC-профили в .bat смотрят только в
#           list-general.txt и ipset-all.txt: видео YouTube (googlevideo.com
#           живёт в list-google.txt) по HTTP/3 иначе остаётся без обхода и
#           страница «не догружается».
#   fake  — движок подделывает QUIC по стратегии. В этом режиме скрипт сам
#           дополняет QUIC-профиль списком list-google.txt, иначе видео мимо.
QUIC=block

# --- прочее ---------------------------------------------------------------
TEST_TIMEOUT=5                 # таймаут одной проверки, секунды
BIGCH_SIZE=0                   # размер ClientHello браузерной пробы, 0 — как у браузера (1538)
UTUN_PEER=10.77.77.2           # адрес на другом конце utun (macws)
ZAPRET_TAG=v72.9               # версия исходников zapret (к ней идёт патч macws)
